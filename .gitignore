# Transient demo / runtime state — never committed.
# (DEMO-TRANSCRIPT.txt and demo/sample/.ocbox-phext/sample.phext ARE kept,
#  as evidence of the recorded demo run.)

# Local shim state (workspaces, sequence counters, session records)
demo/.demo-state/
.ocbox-shim/

# SQ daemon runtime files inside the demo phext store
demo/sample/.ocbox-phext/sq-daemon.json
demo/sample/.ocbox-phext/sq-daemon.log
demo/sample/.ocbox-phext/delta-state.json
demo/sample/.ocbox-phext/.sq/
demo/sample/.ocbox-phext/.ocbox-tmp/
demo/sample/.ocbox-phext/.validate-*/
demo/sample/.ocbox-phext/.phext
demo/sample/.ocbox-phext/*.phext.json

# Layer 2/3/4 state dirs (shim homes, workspaces, SQ runtime files) —
# ignored, EXCEPT the resulting .phext files, which are evidence and stay.
stress/.stress-state/*
!stress/.stress-state/store
stress/.stress-state/store/*
!stress/.stress-state/store/stress.phext

demo/.showcase-state/*
!demo/.showcase-state/store
demo/.showcase-state/store/*
!demo/.showcase-state/store/showcase.phext

demo/.teleport-state/*
!demo/.teleport-state/A
demo/.teleport-state/A/*
!demo/.teleport-state/A/widget
demo/.teleport-state/A/widget/*
!demo/.teleport-state/A/widget/.ocbox-phext
demo/.teleport-state/A/widget/.ocbox-phext/*
!demo/.teleport-state/A/widget/.ocbox-phext/widget.phext
!demo/.teleport-state/B
demo/.teleport-state/B/*
!demo/.teleport-state/B/widget
demo/.teleport-state/B/widget/*
!demo/.teleport-state/B/widget/.ocbox-phext
demo/.teleport-state/B/widget/.ocbox-phext/*
!demo/.teleport-state/B/widget/.ocbox-phext/widget.phext

# Python noise
__pycache__/
*.pyc
