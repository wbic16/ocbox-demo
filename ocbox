}


def main(argv):
    if len(argv) < 2 or argv[1] in ("-h", "--help"):
        print(__doc__.strip().splitlines()[0])
        print("\nusage: ocbox <command> [args]\n\ncommands:")
        short = {"init": "write .ocbox.json in the current directory",
                 "start": "start a Session and write meta + env-names",
                 "exec": "run a command in the session; flush output lanes",
                 "status": "project / session / sequence state",
                 "ls": "list all sessions known to this shim home",
                 "context": "toc + what changed + latest checkpoint",
                 "stop": "pre-stop capture (diff/manifest/checkpoint), stop",
                 "destroy": "delete the session workspace; keep the phext",
                 "teleport-in": "rebuild state from a .phext file alone"}
        for name in ("init", "start", "exec", "status", "ls", "context",
                     "stop", "destroy", "teleport-in"):
            print(f"  {name:<12} {short[name]}")
        print("\nRun `ocbox help <command>` for details. Exit codes: 0 ok, "
              "2 usage/state errors;\n`exec` propagates the wrapped command's exit code.")
        return 0
    if argv[1] == "help":
        topic = argv[2] if len(argv) > 2 else None
        if topic in HELP:
            print(HELP[topic])
            return 0
        print("usage: ocbox help <command> — commands: " + ", ".join(sorted(HELP)))
        return 0 if topic is None else 2
    cmd, rest = argv[1], argv[2:]
    if rest and rest[0] in ("-h", "--help") and cmd in HELP:
        print(HELP[cmd])
        return 0
    if cmd == "exec":
        return cmd_exec(rest)
    fn = COMMANDS.get(cmd)
    if not fn:
        die(f"unknown command {cmd!r} (shim implements: "
            f"{', '.join(sorted(COMMANDS))})")
    fn(rest)
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
