#!/usr/bin/env python3
"""ocbox — opencloudbox-compatible session CLI with a phext audit trail.

Local shim implementing SPEC-v0.2 (see SPEC-v0.2.md in this repo): every
session's lifecycle, transcripts, streams, diffs, manifests, environment
names and checkpoints are written as phext scrolls via SQ.

Transport (fix pass, 2026-11-01 — see GAP-ANALYSIS.md "Transport decision"
addendum): SQ **daemon mode**. The writer runs `sq share <phext>` in the
store directory and drives it through the sq CLI (`pull`/`push` for
byte-exact scroll transfer, `insert` for small appends, `toc`, `save`,
`shutdown`). There is no HTTP host, no port, and no key: the daemon is
filesystem-local IPC scoped to the store directory, and `stop` shuts it
down. `OCBOX_SQ_KEY` is therefore irrelevant locally (kept as a no-op env
var for callers that still set it).

Stdlib only. State lives in $OCBOX_SHIM_HOME (default ~/.ocbox-shim).
"""

import base64
import difflib
import fcntl
import hashlib
import json
import os
import re
import shutil
import signal
import subprocess
import sys
import threading
import time
from datetime import datetime, timezone
from pathlib import Path

CHUNK = 65536
CONFIG_NAME = ".ocbox.json"
REG_PROJ_COORD = "1.1.1/1.1.1/1.1.1"
REG_SESS_COORD = "1.1.1/1.1.2/1.1.1"
CLS = {1: "meta", 2: "transcript", 3: "stdout", 4: "stderr",
       5: "diff", 6: "files", 7: "env", 8: "checkpoint"}
CLS_BY_NAME = {v: k for k, v in CLS.items()}
EXCLUDE_DIRS = {".git", ".ocbox-phext", "node_modules", "__pycache__",
                ".venv", "venv", ".mypy_cache", ".pytest_cache"}
EXCLUDE_FILES = {".ocbox.json"}
EXCLUDE_SUFFIXES = (".phext",)
COORD_RE = re.compile(r"^(\d+)\.(\d+)\.1/(\d+)\.1\.1/(\d+)\.1\.(\d+)$")


def coord(proj, sess, cls, seq, chunk=1):
    return f"{proj}.{sess}.1/{cls}.1.1/{seq}.1.{chunk}"


def now_iso():
    return datetime.now(timezone.utc).strftime("%Y-%m-%dT%H:%M:%SZ")


def die(msg):
    print(f"ocbox: {msg}", file=sys.stderr)
    sys.exit(1)


def sha256_bytes(b):
    return hashlib.sha256(b).hexdigest()


def sha256_file(p):
    h = hashlib.sha256()
    with open(p, "rb") as f:
        for block in iter(lambda: f.read(1 << 20), b""):
            h.update(block)
    return h.hexdigest()


def safe_phext_name(name):
    s = re.sub(r"[^A-Za-z0-9._-]+", "-", name).strip("-.")
    return s or "project"


def sq_binary():
    env = os.environ.get("SQ_BIN")
    if env:
        return Path(env)
    found = shutil.which("sq")
    if found:
        return Path(found)
    return Path.home() / ".cargo" / "bin" / "sq"


def shim_home():
    h = Path(os.environ.get("OCBOX_SHIM_HOME", Path.home() / ".ocbox-shim"))
    h.mkdir(parents=True, exist_ok=True)
    return h


def parse_kv(text):
    d = {}
    for line in text.splitlines():
        if ": " in line:
            k, v = line.split(": ", 1)
            d[k.strip()] = v.strip()
    return d


def parse_tsv(text):
    out = {}
    for line in text.splitlines():
        if "\t" in line:
            k, v = line.split("\t", 1)
            out[k] = v
    return out


# ---------------------------------------------------------------- streams

def encode_stream(data: bytes):
    """Split a byte stream into scroll texts per the encoding policy:
    valid UTF-8 -> plain text chunks of <= CHUNK *characters* (a chunk
    never splits a multi-byte character); anything else -> a base64
    header scroll followed by base64 chunks of the raw bytes."""
    try:
        text = data.decode("utf-8")
    except UnicodeDecodeError:
        header = ("ocbox:encoding=base64\n"
                  f"ocbox:bytes={len(data)}\n"
                  f"ocbox:sha256={sha256_bytes(data)}\n")
        b64 = base64.b64encode(data).decode("ascii")
        return [header] + [b64[i:i + CHUNK] for i in range(0, len(b64), CHUNK)]
    return [text[i:i + CHUNK] for i in range(0, len(text), CHUNK)] or [""]


def decode_stream(scrolls):
    if scrolls and scrolls[0].startswith("ocbox:encoding=base64"):
        return base64.b64decode("".join(scrolls[1:]))
    return "".join(scrolls).encode("utf-8")


# ---------------------------------------------------------------- state

class State:
    """Shim state, serialized across processes: an exclusive flock on
    state.lock is held for the process lifetime, so concurrent ocbox
    invocations queue instead of racing read-modify-write on state.json.
    Writes are atomic (unique tmp file + os.replace)."""

    def __init__(self):
        self.home = shim_home()
        self.path = self.home / "state.json"
        self._lockf = open(self.home / "state.lock", "a+")
        fcntl.flock(self._lockf.fileno(), fcntl.LOCK_EX)
        if self.path.exists():
            self.data = json.loads(self.path.read_text())
        else:
            self.data = {"projects": {}, "next_proj_int": 2}

    def save(self):
        tmp = self.path.with_name(f"state.json.tmp.{os.getpid()}")
        tmp.write_text(json.dumps(self.data, indent=2))
        os.replace(tmp, self.path)

    def get_project(self, root, name):
        proj = self.data["projects"].get(root)
        if proj is None:
            proj = {"name": name, "int": self.data["next_proj_int"],
                    "sessions": {}, "active_session": None, "next_sess_int": 1}
            self.data["next_proj_int"] += 1
            self.data["projects"][root] = proj
        return proj


# ---------------------------------------------------------------- provider

class LocalProvider:
    """Stands in for the ocbox cloud sandbox: a plain directory copy of
    the project. Symlinks are never followed out of the tree (see
    create_workspace's policy)."""

    def __init__(self):
        self.home = shim_home()

    def _path_excluded(self, p, extra=()):
        ap = Path(os.path.abspath(p))
        roots = [self.home] + [Path(e) for e in extra]
        return any(ap == r or r in ap.parents for r in roots)

    def create_workspace(self, project_root, workspace_key, excluded):
        """Copy the project into the session workspace.

        Symlink policy (GAP fix): dir symlinks are never descended into;
        file symlinks are materialized as regular files only when the
        resolved target is a file inside the project tree and not itself
        excluded; every skipped symlink is recorded and returned.
        Returns (workspace_path, skipped_symlinks)."""
        ws_parent = self.home / "sessions" / workspace_key
        ws = ws_parent / "workspace"
        skipped = []
        try:
            if ws_parent.exists():
                shutil.rmtree(ws_parent)
            ws.mkdir(parents=True)
            src_resolved = project_root.resolve()
            for dirpath, dirnames, filenames in os.walk(project_root,
                                                         followlinks=False):
                d = Path(dirpath)
                rel_dir = d.relative_to(project_root)
                (ws / rel_dir).mkdir(parents=True, exist_ok=True)
                keep = []
                for name in sorted(dirnames):
                    p = d / name
                    if name in EXCLUDE_DIRS or self._path_excluded(p, excluded):
                        continue
                    if p.is_symlink():
                        skipped.append({"rel": (rel_dir / name).as_posix(),
                                        "target": os.readlink(p),
                                        "kind": "dir"})
                        continue
                    keep.append(name)
                dirnames[:] = keep
                for name in sorted(filenames):
                    p = d / name
                    rel = (rel_dir / name).as_posix()
                    if (name in EXCLUDE_FILES or name.endswith(EXCLUDE_SUFFIXES)
                            or self._path_excluded(p, excluded)):
                        continue
                    dest = ws / rel_dir / name
                    if p.is_symlink():
                        try:
                            target = p.resolve()
                        except (OSError, RuntimeError):
                            target = None
                        if (target is not None and target.is_file()
                                and target.is_relative_to(src_resolved)
                                and not self._path_excluded(target, excluded)
                                and target.name not in EXCLUDE_FILES
                                and not target.name.endswith(EXCLUDE_SUFFIXES)):
                            shutil.copy2(target, dest)
                        else:
                            skipped.append({"rel": rel,
                                            "target": os.readlink(p),
                                            "kind": "file"})
                    elif p.is_file():
                        shutil.copy2(p, dest)
        except Exception:
            shutil.rmtree(ws_parent, ignore_errors=True)
            raise
        shutil.copytree(ws, ws_parent / "startcopy")
        return ws, skipped

    def snapshot(self, workspace):
        """relpath -> {sha256, size}. Never follows symlinks: a symlink
        (file or dir) is recorded as 'symlink:<target>' with size 0."""
        snap = {}
        workspace = Path(workspace)
        if not workspace.exists():
            return snap
        for dirpath, dirnames, filenames in os.walk(workspace,
                                                     followlinks=False):
            d = Path(dirpath)
            keep = []
            for name in dirnames:
                p = d / name
                rel = p.relative_to(workspace).as_posix()
                if any(part in EXCLUDE_DIRS for part in Path(rel).parts):
                    continue
                if p.is_symlink():
                    snap[rel] = {"sha256": "symlink:" + os.readlink(p),
                                 "size": 0}
                    continue
                keep.append(name)
            dirnames[:] = keep
            for name in filenames:
                p = d / name
                rel = p.relative_to(workspace).as_posix()
                if p.is_symlink():
                    snap[rel] = {"sha256": "symlink:" + os.readlink(p),
                                 "size": 0}
                elif (p.is_file() and name not in EXCLUDE_FILES
                        and not name.endswith(EXCLUDE_SUFFIXES)):
                    try:
                        snap[rel] = {"sha256": sha256_file(p),
                                     "size": p.stat().st_size}
                    except OSError:
                        pass
        return snap

    def run(self, workspace, command, stdin_mode="devnull", timeout_s=None):
        """Run a command in its own process group. SIGINT/SIGTERM to the
        CLI are forwarded to the group before the CLI exits, so a killed
        CLI does not orphan its command. (kill -9 of the CLI cannot be
        handled — nothing can forward then.)"""
        start = time.time()
        proc = subprocess.Popen(
            command, shell=True, cwd=workspace,
            stdin=subprocess.DEVNULL if stdin_mode == "devnull" else None,
            stdout=subprocess.PIPE, stderr=subprocess.PIPE,
            start_new_session=True)
        out_parts, err_parts = [], []

        def pump(stream, parts):
            while True:
                block = stream.read(65536)
                if not block:
                    break
                parts.append(block)

        t_out = threading.Thread(target=pump, args=(proc.stdout, out_parts),
                                 daemon=True)
        t_err = threading.Thread(target=pump, args=(proc.stderr, err_parts),
                                 daemon=True)
        t_out.start()
        t_err.start()

        def forward(sig, _frame):
            try:
                os.killpg(proc.pid, sig)
            except (ProcessLookupError, PermissionError):
                pass

        old_handlers = {}
        for sig in (signal.SIGINT, signal.SIGTERM):
            try:
                old_handlers[sig] = signal.signal(sig, forward)
            except (ValueError, OSError):
                pass
        timed_out = False
        try:
            try:
                rc = proc.wait(timeout=timeout_s)
            except subprocess.TimeoutExpired:
                timed_out = True
                try:
                    os.killpg(proc.pid, signal.SIGTERM)
                except (ProcessLookupError, PermissionError):
                    pass
                try:
                    rc = proc.wait(timeout=2)
                except subprocess.TimeoutExpired:
                    try:
                        os.killpg(proc.pid, signal.SIGKILL)
                    except (ProcessLookupError, PermissionError):
                        pass
                    rc = proc.wait()
        finally:
            for sig, handler in old_handlers.items():
                try:
                    signal.signal(sig, handler)
                except (ValueError, OSError):
                    pass
        t_out.join()
        t_err.join()
        return (rc, b"".join(out_parts), b"".join(err_parts),
                int((time.time() - start) * 1000), timed_out)

    def destroy(self, workspace):
        shutil.rmtree(Path(workspace).parent, ignore_errors=True)


# ---------------------------------------------------------------- phext writer (SQ daemon mode)

class PhextWriter:
    """Drives one phext through an SQ daemon scoped to its store dir.

    The daemon is started with `sq share <file>` (cwd = store dir) and
    adopted on later invocations after `sq status` confirms it is hosting
    THIS phext. Scroll bytes move via `pull`/`push` (byte-exact; `select`
    to stdout appends a trailing newline and is never used for payloads).
    Small appends use `insert` argv (<= 64 KB encoded); larger appends go
    pull+concat+push. Mutations live in daemon memory until `save()`;
    callers save once per command, after their writes."""

    def __init__(self, store_dir, phext_name):
        self.store = Path(store_dir)
        self.store.mkdir(parents=True, exist_ok=True)
        self.p = phext_name
        self.phext_file = self.store / f"{phext_name}.phext"
        self.tmpdir = self.store / ".ocbox-tmp"
        self.tmpdir.mkdir(exist_ok=True)
        self._n = 0
        self._ensure_daemon()

    # -- daemon lifecycle ------------------------------------------------

    def _status_name(self, timeout=5):
        """Name of the phext the in-dir daemon hosts, or None. `sq status`
        blocks while the daemon loads (and forever when no daemon runs),
        so it is always called under a timeout; a timeout means 'not
        (yet) answering', never a hang."""
        try:
            r = subprocess.run([str(sq_binary()), "status"], cwd=self.store,
                               capture_output=True, timeout=timeout)
        except (subprocess.TimeoutExpired, OSError):
            return None
        if r.returncode != 0:
            return None
        lines = r.stdout.decode("utf-8", "replace").splitlines()
        if lines and lines[0].startswith("Hosting: "):
            return lines[0][len("Hosting: "):].strip()
        return None

    def _shutdown_quiet(self):
        try:
            subprocess.run([str(sq_binary()), "shutdown"], cwd=self.store,
                           capture_output=True, timeout=10)
        except Exception:
            pass

    def _recorded_pid_alive(self):
        """True when sq-daemon.json names a live process that really is
        `sq share <this phext>` (verified via /proc cmdline, so a
        recycled pid never counts)."""
        info_f = self.store / "sq-daemon.json"
        if not info_f.exists():
            return False
        try:
            pid = json.loads(info_f.read_text()).get("pid")
        except Exception:
            return False
        if not pid:
            return False
        try:
            os.kill(pid, 0)
            cmdline = Path(f"/proc/{pid}/cmdline").read_bytes() \
                .decode("utf-8", "replace")
        except OSError:
            return False
        return "share" in cmdline and self.phext_file.name in cmdline

    def _store_daemon_pids(self):
        """Pids of `sq share <this phext>` processes whose cwd is THIS
        store dir (found via /proc, so it works even when sq-daemon.json
        is gone). Used for wedged-daemon recovery and shutdown cleanup."""
        pids = []
        for entry in Path("/proc").glob("[0-9]*"):
            try:
                cmdline = (entry / "cmdline").read_bytes() \
                    .decode("utf-8", "replace")
                if "share" not in cmdline or \
                        self.phext_file.name not in cmdline:
                    continue
                if os.readlink(entry / "cwd") == str(self.store):
                    pids.append(int(entry.name))
            except OSError:
                continue
        return pids

    def _dir_daemon_pids(self):
        """Pids of ANY `sq share` process whose cwd is this store dir
        (any phext — used for shared-store takeover and recovery)."""
        pids = []
        for entry in Path("/proc").glob("[0-9]*"):
            try:
                cmdline = (entry / "cmdline").read_bytes() \
                    .decode("utf-8", "replace")
                if "share" not in cmdline or ".phext" not in cmdline:
                    continue
                if os.readlink(entry / "cwd") == str(self.store):
                    pids.append(int(entry.name))
            except OSError:
                continue
        return pids

    def _recover_wedged(self, dir_wide=False):
        """Kill this store's wedged daemon(s) and clear stale .sq state.
        Only ever touches processes verified as `sq share` running in
        this directory (name-filtered unless dir_wide)."""
        pids = self._dir_daemon_pids() if dir_wide else \
            self._store_daemon_pids()
        if pids:
            print(f"ocbox: recovering wedged sq daemon in {self.store} "
                  f"(killing pid(s) {pids}, clearing stale .sq)",
                  file=sys.stderr)
            for pid in pids:
                try:
                    os.kill(pid, signal.SIGKILL)
                except OSError:
                    pass
            time.sleep(1)
        shutil.rmtree(self.store / ".sq", ignore_errors=True)
        (self.store / "sq-daemon.json").unlink(missing_ok=True)

    def _run(self, args, timeout):
        """One sq CLI call; None on timeout (never raises SystemExit)."""
        try:
            return subprocess.run([str(sq_binary()), *args],
                                  cwd=self.store, capture_output=True,
                                  timeout=timeout)
        except (subprocess.TimeoutExpired, OSError):
            return None

    def _warmup_ok(self):
        """One real op with a long fuse as the liveness proof. Probe
        clients killed by short timeouts can leave the daemon's shared
        channel wedged, so liveness is established with a SINGLE call
        that rides out a full phext load instead of a loop of probes."""
        r = self._run(["toc"], timeout=60)
        return r is not None and r.returncode == 0

    def _spawn_and_confirm(self, sq):
        log = open(self.store / "sq-daemon.log", "ab")
        proc = subprocess.Popen(
            [str(sq), "share", self.phext_file.name], cwd=self.store,
            stdout=log, stderr=log, stdin=subprocess.DEVNULL,
            start_new_session=True)
        (self.store / "sq-daemon.json").write_text(json.dumps(
            {"pid": proc.pid, "phext": self.phext_file.name,
             "started": now_iso()}))
        if proc.poll() is not None:
            die(f"sq daemon exited during startup "
                f"(see {self.store}/sq-daemon.log)")
        return self._warmup_ok()

    def _ensure_daemon(self):
        sq = sq_binary()
        if not sq.exists():
            die(f"sq binary not found at {sq} — install SQ "
                f"(`cargo install sq`) or set SQ_BIN. Nothing was created.")
        if not self.phext_file.exists():
            self.phext_file.write_bytes(b"")
        # Serialize startup per store dir. Daemon existence is decided
        # via /proc; liveness via ONE long-fused warm-up op. (Short-
        # timeout `sq status` probes are not free: each killed probe
        # client can wedge the daemon it was asking about — observed
        # live, repeatedly, under load.)
        lockf = open(self.store / "sq-daemon.lock", "a+")
        fcntl.flock(lockf.fileno(), fcntl.LOCK_EX)
        try:
            if self._recorded_pid_alive() or self._store_daemon_pids():
                if self._warmup_ok():
                    return
                self._recover_wedged()
            elif self._dir_daemon_pids():
                # A daemon for a DIFFERENT phext holds this dir's slot
                # (shared multi-project store). Confirm via one patient
                # status, then take the slot over (its owner restarts
                # its own daemon on demand; files are never touched) —
                # or recover it if it is wedged.
                hosting = self._status_name(timeout=20)
                if hosting == self.phext_file.name:
                    if self._warmup_ok():
                        return
                    self._recover_wedged()
                elif hosting is not None:
                    self._shutdown_quiet()
                else:
                    self._recover_wedged(dir_wide=True)
            # Settle: no daemon process for this dir may be alive (even
            # mid-exit) when the new one starts.
            settle_deadline = time.time() + 10
            while self._dir_daemon_pids() and \
                    time.time() < settle_deadline:
                time.sleep(0.2)
            if self._dir_daemon_pids():
                self._recover_wedged(dir_wide=True)
            shutil.rmtree(self.store / ".sq", ignore_errors=True)
            if self._spawn_and_confirm(sq):
                return
            # One full retry after a recovery cycle, then give up loudly.
            self._recover_wedged()
            if self._spawn_and_confirm(sq):
                return
            die(f"sq daemon did not come up for {self.phext_file.name} "
                f"in {self.store} (see sq-daemon.log)")
        finally:
            lockf.close()

    def shutdown(self):
        """Stop the store's daemon (clean `sq shutdown`, SIGTERM only to
        a recorded pid verified as our `sq share` process)."""
        self._shutdown_quiet()
        info_f = self.store / "sq-daemon.json"
        pid = None
        if info_f.exists():
            try:
                pid = json.loads(info_f.read_text()).get("pid")
            except Exception:
                pid = None
        if pid:
            alive = True
            for _ in range(30):
                try:
                    os.kill(pid, 0)
                except OSError:
                    alive = False
                    break
                time.sleep(0.1)
            if alive:
                try:
                    cmdline = Path(f"/proc/{pid}/cmdline").read_bytes() \
                        .decode("utf-8", "replace")
                except OSError:
                    cmdline = ""
                if "share" in cmdline and self.phext_file.name in cmdline:
                    try:
                        os.kill(pid, signal.SIGTERM)
                    except OSError:
                        pass
        # Belt-and-braces: any verified store daemon still alive after
        # the clean shutdown gets a SIGTERM (same /proc verification),
        # and we wait for it to actually die — a daemon still exiting
        # can wedge the next spawn on this store.
        for leftover in self._store_daemon_pids():
            try:
                os.kill(leftover, signal.SIGTERM)
            except OSError:
                pass
        for _ in range(50):
            if not self._store_daemon_pids():
                break
            time.sleep(0.1)
        # A daemon that ignored SIGTERM (wedged channel) is SIGKILLed —
        # verified store scope only — so `stop` really stops it.
        for stubborn in self._store_daemon_pids():
            try:
                os.kill(stubborn, signal.SIGKILL)
            except OSError:
                pass
        info_f.unlink(missing_ok=True)

    # -- scroll ops --------------------------------------------------------

    def _cli(self, args, timeout=30):
        try:
            r = subprocess.run([str(sq_binary()), *args], cwd=self.store,
                               capture_output=True, timeout=timeout)
        except subprocess.TimeoutExpired:
            die(f"SQ daemon did not answer `{args[0]}` within {timeout}s "
                f"(store {self.store}) — the daemon may be wedged; this "
                f"call wrote nothing.")
        if r.returncode != 0:
            msg = (r.stderr or r.stdout).decode("utf-8", "replace") \
                .strip()[:300]
            die(f"SQ `{args[0]}` failed (exit {r.returncode}): {msg}")
        return r

    def _tmp(self):
        self._n += 1
        return self.tmpdir / f"op-{os.getpid()}-{self._n}.tmp"

    def _pull_bytes(self, c):
        f = self._tmp()
        self._cli(["pull", c, str(f)])
        data = f.read_bytes() if f.exists() else b""
        f.unlink(missing_ok=True)
        return data

    def select(self, c):
        return self._pull_bytes(c).decode("utf-8", "replace")

    def update(self, c, text):
        f = self._tmp()
        f.write_bytes(text.encode("utf-8"))
        try:
            self._cli(["push", c, str(f)])
        finally:
            f.unlink(missing_ok=True)

    def insert(self, c, text):
        data = text.encode("utf-8")
        if len(data) <= CHUNK:
            self._cli(["insert", c, text])
        else:
            f = self._tmp()
            f.write_bytes(self._pull_bytes(c) + data)
            try:
                self._cli(["push", c, str(f)])
            finally:
                f.unlink(missing_ok=True)

    def toc(self):
        return self._cli(["toc"], timeout=60).stdout.decode("utf-8",
                                                             "replace")

    def save(self):
        self._cli(["save", self.phext_file.name], timeout=120)

    def checksum(self):
        """Whole-phext identity for THIS writer = SHA-256 of the phext
        file once this command's writes are saved. (Daemon `checksum`
        is per-scroll only, and `delta` differs across SQ versions, so
        neither is used for whole-phext identity.)"""
        self.save()
        return sha256_file(self.phext_file)

    def export_exact_bytes(self):
        """{coord: raw scroll bytes} for the whole phext, via toc+pull.
        (json-export is lossy and `select` appends a newline; pull is
        byte-exact.)"""
        out = {}
        for line in self.toc().splitlines():
            if line.startswith("* "):
                c = line[2:].split(":", 1)[0].strip()
                if c:
                    out[c] = self._pull_bytes(c)
        return out

    def export_exact(self):
        return {c: b.decode("utf-8", "replace")
                for c, b in self.export_exact_bytes().items()}

    def lane_map(self, proj_int, sess_int):
        """coord -> sha256(raw scroll bytes) for one session's scrolls,
        checkpoint class excluded (the map lives in that class)."""
        m = {}
        for c, b in self.export_exact_bytes().items():
            mm = COORD_RE.match(c)
            if (mm and (int(mm.group(1)), int(mm.group(2)))
                    == (proj_int, sess_int) and int(mm.group(3)) != 8):
                m[c] = sha256_bytes(b)
        return m

    # -- registry ----------------------------------------------------------

    def registry_names(self):
        return parse_tsv(self.select(REG_PROJ_COORD))

    def ensure_registry(self, proj_name, proj_int, sess_id, sess_int):
        reg = self.select(REG_PROJ_COORD)
        names = parse_tsv(reg)
        if names.get(proj_name) != str(proj_int):
            if reg and not reg.endswith("\n"):
                reg += "\n"
            self.update(REG_PROJ_COORD,
                        reg + f"{proj_name}\t{proj_int}\n")
        sreg = self.select(REG_SESS_COORD)
        snames = parse_tsv(sreg)
        if snames.get(sess_id) != str(sess_int):
            if sreg and not sreg.endswith("\n"):
                sreg += "\n"
            self.update(REG_SESS_COORD, sreg + f"{sess_id}\t{sess_int}\n")


# ---------------------------------------------------------------- project helpers

def find_project_root():
    here = Path.cwd()
    for cand in [here] + list(here.parents):
        cfg = cand / CONFIG_NAME
        if cfg.exists():
            return cand, json.loads(cfg.read_text())
    die(f"no {CONFIG_NAME} found here or in any parent directory "
        f"(run `ocbox init` first)")


def store_dir_for(root, cfg):
    return Path(cfg.get("phext_store") or (root / ".ocbox-phext"))


def writer_for(root, cfg):
    store = store_dir_for(root, cfg)
    return PhextWriter(store, safe_phext_name(cfg["project"]))


def get_session(state, root, cfg, need_active):
    proj = state.data["projects"].get(str(root))
    if proj is None:
        die("no sessions recorded for this project yet")
    sid = proj.get("active_session")
    if need_active:
        if not sid:
            die("no active session for this project (run `ocbox start`)")
    else:
        if not sid:
            if not proj["sessions"]:
                die("no sessions recorded for this project yet")
            sid = sorted(proj["sessions"])[-1]
    return proj, proj["sessions"][sid]


SECRET_NAME_RE = re.compile(
    r"(SECRET|TOKEN|PASSWORD|PASSWD|API_?KEY|PRIVATE_?KEY|CREDENTIAL|"
    r"ACCESS_?KEY|AUTH)", re.IGNORECASE)


def git_origin_name_set():
    """{VARNAME: value} for git-config-style values that are NAMES or
    secret references (remote URLs may embed hosts/paths but are config
    references, not secret values)."""
    out = {}
    try:
        r = subprocess.run(["git", "config", "--list", "--null"],
                           capture_output=True, timeout=5)
        for entry in r.stdout.decode("utf-8", "replace").split("\0"):
            if "\n" in entry:
                k, v = entry.split("\n", 1)
                out[k] = v
    except Exception:
        pass
    return out


def env_names():
    """Names + secret REFERENCES only — never values (SPEC SS2/SS7).

    An entry is recorded when it is a name (value empty), a reference
    (vault://, ${...}, or a NAME=OTHER_NAME indirection), or a var whose
    name marks it as secret-bearing (value replaced by a reference to
    the variable itself). Non-secret plain values are not recorded at
    all: the env lane answers "what configuration did this session run
    with", not "what were the values"."""
    names = {}
    for k, v in sorted(os.environ.items()):
        if v == "":
            names[k] = "set (empty)"
        elif v.startswith(("vault://", "secret://", "${")):
            names[k] = v
        elif re.fullmatch(r"[A-Z_][A-Z0-9_]*", v or ""):
            names[k] = f"ref:{v}"
        elif SECRET_NAME_RE.search(k):
            names[k] = "ref:self (value withheld)"
    for k, v in sorted(git_origin_name_set().items()):
        names[f"git.{k}"] = v
    return names


# ---------------------------------------------------------------- recording helpers

def store_stream(w, proj_int, sess_int, cls, seq, data: bytes):
    chunks = encode_stream(data)
    for i, text in enumerate(chunks, start=1):
        w.update(coord(proj_int, sess_int, cls, seq, i), text)
    return len(chunks)


def store_streams_with_return(w, proj_int, sess_int, seq, out_b, err_b):
    n_out = store_stream(w, proj_int, sess_int, 3, seq, out_b)
    n_err = store_stream(w, proj_int, sess_int, 4, seq, err_b)
    return n_out, n_err


def build_diff(start_snapshot, end_snapshot, workspace, startcopy):
    """Unified diffs for changed text files (<= 256 KB/side); all other
    changes are recorded as hash lines so nothing is silently dropped."""
    lines = []
    all_rels = sorted(set(start_snapshot) | set(end_snapshot))
    for rel in all_rels:
        old = start_snapshot.get(rel)
        new = end_snapshot.get(rel)
        if old == new:
            continue
        lines.append(f"--- diff for {rel} ---\n")
        if old is None:
            text_diff = None
            new_file = Path(workspace) / rel
            if (new["size"] <= 262144 and new_file.is_file()
                    and not new_file.is_symlink()):
                try:
                    new_text = new_file.read_text()
                    text_diff = "".join(difflib.unified_diff(
                        [], new_text.splitlines(keepends=True),
                        fromfile="/dev/null", tofile=f"b/{rel}"))
                except (UnicodeDecodeError, OSError):
                    text_diff = None
            if text_diff:
                lines.append(text_diff)
            else:
                lines.append(f"added ({new['size']} bytes)\n"
                             f"sha256 at stop: {new['sha256']}\n")
        elif new is None:
            lines.append(f"deleted ({old['size']} bytes)\n"
                         f"sha256 at start: {old['sha256']}\n")
        else:
            old_file = Path(startcopy) / rel
            new_file = Path(workspace) / rel
            text_diff = None
            if (old["size"] <= 262144 and new["size"] <= 262144
                    and old_file.is_file() and new_file.is_file()
                    and not old_file.is_symlink()
                    and not new_file.is_symlink()):
                try:
                    old_text = old_file.read_text()
                    new_text = new_file.read_text()
                    text_diff = "".join(difflib.unified_diff(
                        old_text.splitlines(keepends=True),
                        new_text.splitlines(keepends=True),
                        fromfile=f"a/{rel}", tofile=f"b/{rel}"))
                except (UnicodeDecodeError, OSError):
                    text_diff = None
            if text_diff:
                lines.append(text_diff)
            else:
                lines.append(f"modified ({old['size']} -> {new['size']} "
                             f"bytes)\n"
                             f"sha256 at start: {old['sha256']}\n"
                             f"sha256 at stop: {new['sha256']}\n")
    return "".join(lines), end_snapshot


