# ---------------------------------------------------------------- redaction (OCBOX_REDACT)

def compile_redactions():
    raw = os.environ.get("OCBOX_REDACT", "")
    pats = []
    for piece in raw.split(","):
        piece = piece.strip()
        if not piece:
            continue
        try:
            pats.append(re.compile(piece.encode("utf-8")))
        except re.error:
            die(f"OCBOX_REDACT: invalid regex {piece!r}")
    return pats


def redact_bytes(data: bytes, pats):
    total = 0
    for p in pats:
        data, n = p.subn(b"[redacted]", data)
        total += n
    return data, total


def redact_text(text, pats):
    if not pats:
        return text, 0
    data, n = redact_bytes(text.encode("utf-8"), pats)
    return data.decode("utf-8", "replace"), n


# ---------------------------------------------------------------- commands

def exec_timeout_default():
    raw = os.environ.get("OCBOX_EXEC_TIMEOUT", "").strip()
    if not raw:
        return None
    try:
        return float(raw)
    except ValueError:
        die(f"OCBOX_EXEC_TIMEOUT is not a number: {raw!r}")


def cmd_init(argv):
    if argv:
        die("usage: ocbox init")
    root = Path.cwd()
    f = root / CONFIG_NAME
    if f.exists():
        print(f"{CONFIG_NAME} already exists for project "
              f"{json.loads(f.read_text())['project']!r}")
        return 0
    state = State()
    safe = safe_phext_name(root.name)
    for other_root, proj in state.data["projects"].items():
        if proj["name"] == root.name:
            continue
        if safe_phext_name(proj["name"]) != safe:
            continue
        other_cfg = {}
        other_cfg_f = Path(other_root) / CONFIG_NAME
        if other_cfg_f.exists():
            try:
                other_cfg = json.loads(other_cfg_f.read_text())
            except Exception:
                other_cfg = {}
        if store_dir_for(Path(other_root), other_cfg) == \
                store_dir_for(root, {}):
            die(f"project name {root.name!r} collides with project "
                f"{proj['name']!r}: both map to phext file {safe}.phext "
                f"in the same store — rename one project directory")
    cfg = {"project": root.name, "phext_store": None, "env_refs": []}
    f.write_text(json.dumps(cfg, indent=2) + "\n")
    print(f"initialized project {root.name!r} ({CONFIG_NAME})")
    return 0


def _close_session(state, proj, sess, w, provider):
    """Capture diff + manifest + lane-hash map + checkpoint for a session
    and mark it stopped in (unsaved) state. Returns (checkpoint_coord,
    workspace_missing). The daemon is left running; callers decide when
    to shut it down."""
    pi, si = proj["int"], sess["int"]
    ws = Path(sess["workspace"])
    missing = not ws.exists()
    end_snap = {} if missing else provider.snapshot(ws)
    startcopy = ws.parent / "startcopy"
    diff_text, _ = build_diff(sess["start_snapshot"], end_snap, ws,
                              startcopy)
    if missing:
        diff_text = "workspace: missing at stop\n" + diff_text
    w.update(coord(pi, si, 5, 1), diff_text)
    man_lines = []
    for rel in sorted(end_snap):
        e = end_snap[rel]
        man_lines.append(f"{rel}\t{e['size']}\t{e['sha256']}")
    for sk in sess.get("symlinks_skipped", []):
        man_lines.append(f"symlink-skipped:{sk['rel']}\t0\t"
                         f"symlink:{sk['target']}")
    manifest_text = "".join(ln + "\n" for ln in man_lines)
    w.update(coord(pi, si, 6, 1), manifest_text)
    # Lane-hash map (SPEC-v0.3 candidate): per-scroll SHA-256 for this
    # session, written after diff+manifest so it covers them; context
    # change detection and teleport verification read it.
    lane_map = w.lane_map(pi, si)
    map_text = "".join(f"{c}\t{h}\n" for c, h in sorted(lane_map.items()))
    map_sha = sha256_bytes(map_text.encode("utf-8"))
    w.update(coord(pi, si, 8, 2), map_text)
    max_seq = {}
    for c in lane_map:
        m = COORD_RE.match(c)
        if m:
            cls_i, seq_i = int(m.group(3)), int(m.group(4))
            max_seq[cls_i] = max(max_seq.get(cls_i, 0), seq_i)
    prev_sha = ""
    if si > 1:
        prev_ck = w.select(coord(pi, si - 1, 8, 1))
        if prev_ck.strip():
            prev_sha = sha256_bytes(prev_ck.encode("utf-8"))
    w.save()
    pre = sha256_file(w.phext_file)
    stopped = now_iso()
    ckpt_coord = coord(pi, si, 8, 1)
    lines = [f"session: {sess['id']}",
             f"session_int: {si}",
             f"project_int: {pi}",
             f"stopped: {stopped}",
             f"final_seq: {sess['last_seq']}"]
    for cls_i in sorted(CLS):
        if cls_i == 8:
            lines.append("max_seq_checkpoint: 1")
        elif cls_i in max_seq:
            lines.append(f"max_seq_{CLS[cls_i]}: {max_seq[cls_i]}")
    lines.append(f"lane_map_coord: {coord(pi, si, 8, 2)}")
    lines.append(f"lane_map_sha256: {map_sha}")
    lines.append(f"lane_map_scrolls: {len(lane_map)}")
    if prev_sha:
        lines.append(f"prev_checkpoint_sha256: {prev_sha}")
    lines.append(f"pre_checkpoint_checksum: {pre}")
    lines.append(f"delta_sha256: {map_sha}")
    if missing:
        lines.append("workspace: missing at stop")
    ckpt_text = "\n".join(lines) + "\n"
    w.update(ckpt_coord, ckpt_text)
    w.save()
    sess["status"] = "stopped"
    sess["stopped"] = stopped
    sess["checkpoint_coord"] = ckpt_coord
    if proj.get("active_session") == sess["id"]:
        proj["active_session"] = None
    return ckpt_coord, missing


def cmd_start(argv):
    if argv:
        die("usage: ocbox start")
    root, cfg = find_project_root()
    state = State()
    proj = state.get_project(str(root), cfg["project"])
    provider = LocalProvider()
    # Transport preflight BEFORE any state or workspace exists: if SQ is
    # missing the writer dies here and no phantom session is left behind.
    w = writer_for(root, cfg)
    for n in w.registry_names():
        if n != cfg["project"] and safe_phext_name(n) == w.p:
            die(f"project name {cfg['project']!r} collides with "
                f"registered project {n!r}: both map to {w.p}.phext in "
                f"this store — rename the project or give it its own "
                f"phext_store")
    if proj.get("active_session"):
        old = proj["sessions"][proj["active_session"]]
        print(f"rotating: closing active session {old['id']} first")
        _close_session(state, proj, old, w, provider)
    sess_int = proj["next_sess_int"]
    sess_id = f"s_{sess_int}"
    ws_key = f"{safe_phext_name(cfg['project'])}-{sess_id}"
    try:
        ws, skipped = provider.create_workspace(
            root, ws_key, {store_dir_for(root, cfg)})
    except Exception as e:
        die(f"could not create session workspace: {e}")
    sess = {"id": sess_id, "int": sess_int, "status": "active",
            "started": now_iso(), "stopped": None, "workspace": str(ws),
            "start_snapshot": provider.snapshot(ws), "last_seq": 1,
            "checkpoint_coord": None, "symlinks_skipped": skipped}
    proj["sessions"][sess_id] = sess
    proj["active_session"] = sess_id
    proj["next_sess_int"] = sess_int + 1
    state.save()
    pi = proj["int"]
    w.ensure_registry(cfg["project"], pi, sess_id, sess_int)
    meta = (f"project: {cfg['project']}\nproject_int: {pi}\n"
            f"session: {sess_id}\nsession_int: {sess_int}\n"
            f"started: {sess['started']}\nprovider: local-shim\n"
            f"workspace: {ws}\n")
    prevs = [s for s in proj["sessions"].values()
             if s["int"] < sess_int and s.get("checkpoint_coord")]
    if prevs:
        prev = max(prevs, key=lambda s: s["int"])
        ck = parse_kv(w.select(prev["checkpoint_coord"]))
        if ck.get("pre_checkpoint_checksum"):
            meta += (f"continuation_of_session: {prev['id']}\n"
                     f"continuation_checkpoint_coord: "
                     f"{prev['checkpoint_coord']}\n"
                     f"continuation_checkpoint_checksum: "
                     f"{ck['pre_checkpoint_checksum']}\n")
    for sk in skipped:
        meta += (f"symlink-skipped: {sk['rel']} -> {sk['target']} "
                 f"({sk['kind']} symlink)\n")
    w.update(coord(pi, sess_int, 1, 1), meta)
    env = env_names()
    for name in cfg.get("env_refs", []):
        if name not in env:
            env[name] = ("ref:self (value withheld)"
                         if os.environ.get(name) else "declared (not set)")
    w.update(coord(pi, sess_int, 7, 1),
             "".join(f"{k}\t{v}\n" for k, v in env.items()))
    w.save()
    print(f"session {sess_id} started — project {cfg['project']} "
          f"(int {pi})")
    print(f"workspace: {ws}")
    if skipped:
        print(f"symlinks skipped at start: {len(skipped)} "
              f"(recorded in meta + manifest)")
    return 0


def cmd_exec(argv):
    interactive = False
    timeout_s = exec_timeout_default()
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--":
            i += 1
            break
        if a == "--interactive":
            interactive = True
            i += 1
            continue
        if a == "--timeout":
            if i + 1 >= len(argv):
                die("exec: --timeout needs a value in seconds")
            try:
                timeout_s = float(argv[i + 1])
            except ValueError:
                die(f"exec: bad --timeout value {argv[i + 1]!r}")
            i += 2
            continue
        if a.startswith("--timeout="):
            try:
                timeout_s = float(a.split("=", 1)[1])
            except ValueError:
                die(f"exec: bad --timeout value {a!r}")
            i += 1
            continue
        break
    cmd_args = argv[i:]
    if not cmd_args:
        die("usage: ocbox exec [--interactive] [--timeout SECONDS] "
            "[--] <command...>")
    command = " ".join(cmd_args)
    root, cfg = find_project_root()
    state = State()
    proj, sess = get_session(state, root, cfg, need_active=True)
    provider = LocalProvider()
    pats = compile_redactions()
    rc, out_b, err_b, dur_ms, timed_out = provider.run(
        sess["workspace"], command,
        stdin_mode="inherit" if interactive else "devnull",
        timeout_s=timeout_s)
    cmd_record, n_cmd = redact_text(command, pats)
    out_r, n_out = redact_bytes(out_b, pats)
    err_r, n_err = redact_bytes(err_b, pats)
    w = writer_for(root, cfg)
    pi, si = proj["int"], sess["int"]
    seq = sess["last_seq"] + 1
    # Streams first, transcript LAST: the transcript is the commit
    # record — if it exists, the exec happened. The sequence counter in
    # state advances only after the phext writes land.
    n_out_chunks, n_err_chunks = store_streams_with_return(
        w, pi, si, seq, out_r, err_r)

    def enc_label(b):
        try:
            b.decode("utf-8")
            return "text"
        except UnicodeDecodeError:
            return "base64"

    transcript = "$ " + cmd_record + "\n" + (
        f"started: {now_iso()}\n"
        f"cwd: {sess['workspace']}\n"
        f"exit: {rc}\n"
        f"duration_ms: {dur_ms}\n"
        f"timed_out: {'true' if timed_out else 'false'}\n"
        f"stdout_chunks: {n_out_chunks}\n"
        f"stderr_chunks: {n_err_chunks}\n"
        f"stdout_bytes: {len(out_r)}\n"
        f"stderr_bytes: {len(err_r)}\n"
        f"stdout_sha256: {sha256_bytes(out_r)}\n"
        f"stderr_sha256: {sha256_bytes(err_r)}\n"
        f"stdout_encoding: {enc_label(out_r)}\n"
        f"stderr_encoding: {enc_label(err_r)}\n")
    if rc < 0:
        try:
            signame = signal.Signals(-rc).name
        except ValueError:
            signame = f"signal {-rc}"
        transcript += f"signal: {signame}\n"
    if pats:
        transcript += f"redactions: {n_cmd + n_out + n_err}\n"
    w.update(coord(pi, si, 2, seq), transcript)
    w.insert(coord(pi, si, 1, 1),
             f"exec {seq}: {cmd_record} (exit {rc})\n")
    sess["last_seq"] = seq
    state.save()
    w.save()
    sys.stdout.buffer.write(out_r)
    sys.stdout.buffer.flush()
    sys.stderr.buffer.write(err_r)
    sys.stderr.buffer.flush()
    return rc


def cmd_stop(argv):
    if argv:
        die("usage: ocbox stop")
    root, cfg = find_project_root()
    state = State()
    proj, sess = get_session(state, root, cfg, need_active=True)
    provider = LocalProvider()
    w = writer_for(root, cfg)
    ckpt_coord, missing = _close_session(state, proj, sess, w, provider)
    state.save()
    w.shutdown()
    if missing:
        print(f"record closed (workspace missing) — checkpoint at "
              f"{ckpt_coord}")
    else:
        print(f"record complete — checkpoint at {ckpt_coord}")
    return 0


def cmd_context(argv):
    lane = None
    sess_filter = None
    full = False
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--full":
            full = True
            i += 1
        elif a == "--lane" or a.startswith("--lane="):
            if a == "--lane":
                if i + 1 >= len(argv):
                    die("context: --lane needs a class name or number")
                v = argv[i + 1]
                i += 2
            else:
                v = a.split("=", 1)[1]
                i += 1
            if v in CLS_BY_NAME:
                lane = CLS_BY_NAME[v]
            else:
                try:
                    lane = int(v)
                except ValueError:
                    die(f"context: unknown lane {v!r} (classes: "
                        f"{', '.join(CLS.values())})")
                if lane not in CLS:
                    die(f"context: lane {lane} out of range 1-8")
        elif a == "--session" or a.startswith("--session="):
            if a == "--session":
                if i + 1 >= len(argv):
                    die("context: --session needs a session int")
                v = argv[i + 1]
                i += 2
            else:
                v = a.split("=", 1)[1]
                i += 1
            try:
                sess_filter = int(v)
            except ValueError:
                die(f"context: bad --session value {v!r}")
        else:
            die(f"context: unknown argument {a!r}")
    root, cfg = find_project_root()
    w = writer_for(root, cfg)
    w.save()  # flush any adopted daemon state: the file hash must be honest
    store = store_dir_for(root, cfg)
    entries = []
    for line in w.toc().splitlines():
        if line.startswith("* "):
            c, _, prev = line[2:].partition(": ")
            entries.append((c.strip(), prev))
    coords = [c for c, _ in entries]
    print(f"=== context: {cfg['project']} (phext {w.p}) ===")
    if full or lane is not None or sess_filter is not None:
        print("=== toc ===")
        for c, prev in entries:
            m = COORD_RE.match(c)
            if lane is not None and (not m or int(m.group(3)) != lane):
                continue
            if sess_filter is not None and (
                    not m or int(m.group(2)) != sess_filter):
                continue
            print(f"* {c}: {prev[:100]}")
    else:
        print("=== toc (summary) ===")
        reg = [c for c in coords if c.startswith("1.")]
        print(f"registry: {len(reg)} scrolls")
        sessions = {}
        for c in coords:
            m = COORD_RE.match(c)
            if not m or int(m.group(1)) == 1:
                continue
            key = (int(m.group(1)), int(m.group(2)))
            counts = sessions.setdefault(key, {})
            counts[int(m.group(3))] = counts.get(int(m.group(3)), 0) + 1
        for (pi, si) in sorted(sessions):
            counts = sessions[(pi, si)]
            desc = ", ".join(f"{CLS[cl]} {n}"
                             for cl, n in sorted(counts.items()))
            print(f"session {pi}.{si}: {sum(counts.values())} scrolls "
                  f"— {desc}")
    cur_sha = sha256_file(w.phext_file)
    ds = read_delta_state(store)
    print("Coordinates changed since last context:")
    if ds and ds.get("phext_sha256") == cur_sha:
        print(f"  (no changes — phext file unchanged since "
              f"{ds.get('taken', '?')})")
    else:
        exported = w.export_exact_bytes()
        fresh = {c: sha256_bytes(b) for c, b in exported.items()}
        old = dict((ds or {}).get("scroll_sha256") or {})
        note = ""
        if not old:
            for c, b in exported.items():
                m = COORD_RE.match(c)
                if m and int(m.group(3)) == 8 and int(m.group(5)) == 2:
                    old.update(parse_tsv(b.decode("utf-8", "replace")))
            if old:
                note = " — baseline: checkpoint lane maps"
        changed = sorted(c for c in set(fresh) | set(old)
                         if fresh.get(c) != old.get(c))
        if changed:
            for c in changed:
                print(f"  {c}")
        else:
            print(f"  (no changes{note})")
        write_delta_state(store, cur_sha, fresh)
    ckpts = []
    for c in coords:
        m = COORD_RE.match(c)
        if (m and int(m.group(3)) == 8 and int(m.group(4)) == 1
                and int(m.group(5)) == 1):
            ckpts.append(c)
    if ckpts:
        last = max(ckpts, key=lambda c: tuple(
            int(x) for x in re.findall(r"\d+", c)))
        print("=== last checkpoint ===")
        text = w.select(last)
        sys.stdout.write(text if text.endswith("\n") else text + "\n")
    return 0


# ---------------------------------------------------------------- teleport-in

def lane_chunks(export, proj_int, sess_int, cls, seq):
    out = {}
    for c, b in export.items():
        m = COORD_RE.match(c)
        if (m and (int(m.group(1)), int(m.group(2)), int(m.group(3)),
                   int(m.group(4))) == (proj_int, sess_int, cls, seq)):
            out[int(m.group(5))] = b
    return [out[k] for k in sorted(out)]


def verify_streams(export, proj_int):
    """Re-hash every recorded stream against its transcript. Returns
    (checked, failed, [bad descriptions])."""
    checked = failed = 0
    bad = []
    for c, b in export.items():
        m = COORD_RE.match(c)
        if (not m or int(m.group(1)) != proj_int or int(m.group(3)) != 2
                or int(m.group(5)) != 1):
            continue
        si, seq = int(m.group(2)), int(m.group(4))
        kv = parse_kv(b.decode("utf-8", "replace"))
        for cls, key, ckey in ((3, "stdout_sha256", "stdout_chunks"),
                               (4, "stderr_sha256", "stderr_chunks")):
            want = kv.get(key)
            if not want:
                continue
            chunks = lane_chunks(export, proj_int, si, cls, seq)
            if chunks:
                if chunks[0].startswith(b"ocbox:encoding=base64"):
                    data = base64.b64decode(b"".join(chunks[1:]))
                else:
                    data = b"".join(chunks)
            else:
                # An empty stream materializes as NO scroll (a phext
                # cannot distinguish "present but empty" from absent);
                # the transcript's hash of the empty byte string is the
                # record, and it verifies exactly.
                data = b""
            checked += 1
            if sha256_bytes(data) != want:
                failed += 1
                declared = kv.get(ckey, "?")
                bad.append(f"{c} ({CLS[cls]}: {len(chunks)} chunks "
                           f"present, transcript declares {declared}, "
                           f"hash mismatch)")
    return checked, failed, bad


def cmd_teleport_in(argv):
    expect = None
    adopt = False
    positional = []
    i = 0
    while i < len(argv):
        a = argv[i]
        if a == "--adopt":
            adopt = True
            i += 1
        elif a == "--expect-sha256":
            if i + 1 >= len(argv):
                die("teleport-in: --expect-sha256 needs a hex digest")
            expect = argv[i + 1].lower()
            i += 2
        elif a.startswith("--expect-sha256="):
            expect = a.split("=", 1)[1].lower()
            i += 1
        else:
            positional.append(a)
            i += 1
    if len(positional) != 1:
        die("usage: ocbox teleport-in [--expect-sha256 HEX] [--adopt] "
            "<phext-file>")
    src = Path(positional[0])
    if not src.exists():
        die(f"teleport-in: no such file: {src}")
    src_sha = sha256_file(src)
    if expect and src_sha != expect:
        die(f"teleport-in: SHA-256 mismatch — expected {expect}, "
            f"file hashes to {src_sha}. Refusing to import.")
    root, cfg = find_project_root()
    store = store_dir_for(root, cfg)
    store.mkdir(parents=True, exist_ok=True)

    # ---- validate on a COPY in a scratch store; the real store is only
    # touched after the phext has proven itself.
    vdir = store / f".validate-{os.getpid()}"
    shutil.rmtree(vdir, ignore_errors=True)
    vdir.mkdir(parents=True)
    shutil.copy2(src, vdir / "incoming.phext")
    vw = PhextWriter(vdir, "incoming")
    try:
        export = vw.export_exact_bytes()
    finally:
        vw.shutdown()
        shutil.rmtree(vdir, ignore_errors=True)
    proj_reg = parse_tsv(export.get(REG_PROJ_COORD, b"").decode(
        "utf-8", "replace"))
    sess_reg = parse_tsv(export.get(REG_SESS_COORD, b"").decode(
        "utf-8", "replace"))
    if not proj_reg:
        die("teleport-in: no project registry scroll "
            "(1.1.1/1.1.1/1.1.1) — this is not an ocbox phext, or its "
            "head is truncated. Refusing to import.")
    local_name = cfg["project"]
    adopted = False
    if local_name in proj_reg:
        reg_name, pi = local_name, int(proj_reg[local_name])
    elif adopt and len(proj_reg) == 1:
        reg_name = next(iter(proj_reg))
        pi = int(proj_reg[reg_name])
        adopted = True
    elif adopt:
        die(f"teleport-in: --adopt needs exactly one project in the "
            f"phext registry; found {sorted(proj_reg)}")
    else:
        die(f"teleport-in: project mismatch — phext is for "
            f"{sorted(proj_reg)}, this project is {local_name!r}. "
            f"Refusing to import (pass --adopt to take the phext's "
            f"project identity).")

    warnings = []
    sessions_info = {}
    sess_ints = sorted({int(COORD_RE.match(c).group(2))
                        for c in export
                        if COORD_RE.match(c)
                        and int(COORD_RE.match(c).group(1)) == pi})
    id_by_int = {}
    for sid, sint in sess_reg.items():
        try:
            id_by_int[int(sint)] = sid
        except ValueError:
            pass
    for si in sess_ints:
        lanes = [c for c in export
                 if (lambda m: m and int(m.group(1)) == pi
                     and int(m.group(2)) == si)(COORD_RE.match(c))]
        max_seq = max((int(COORD_RE.match(c).group(4)) for c in lanes),
                      default=0)
        trans_seqs = sorted({int(COORD_RE.match(c).group(4))
                             for c in lanes
                             if int(COORD_RE.match(c).group(3)) == 2})
        ck_b = export.get(coord(pi, si, 8, 1))
        info = {"lanes": lanes, "max_seq": max_seq,
                "transcripts": trans_seqs, "checkpoint": None}
        if ck_b is None:
            warnings.append(
                f"session {si}: no checkpoint — rebuilt as INTERRUPTED; "
                f"next sequence = {max_seq + 1} (derived from the lanes)")
        else:
            ck = parse_kv(ck_b.decode("utf-8", "replace"))
            info["checkpoint"] = ck
            try:
                final_seq = int(ck.get("final_seq", "0"))
            except ValueError:
                final_seq = 0
            if trans_seqs and final_seq < max(trans_seqs):
                warnings.append(
                    f"session {si}: checkpoint final_seq {final_seq} < "
                    f"highest transcript seq {max(trans_seqs)} — "
                    f"checkpoint is stale or the phext is truncated")
            if coord(pi, si, 6, 1) not in export:
                warnings.append(
                    f"session {si}: checkpoint present but manifest "
                    f"scroll missing — phext is incomplete")
        sessions_info[si] = info
    checked, failed, bad = verify_streams(export, pi)
    if failed:
        warnings.append(
            f"stream verification: {failed}/{checked} recorded streams "
            f"fail their transcript hashes ({'; '.join(bad[:3])})")
    verdict = "DEGRADED" if warnings else "OK"

    # ---- install + rebuild writer state from the phext alone
    dest = store / f"{safe_phext_name(reg_name)}.phext"
    replaced = dest.exists() and src.resolve() != dest.resolve()
    if src.resolve() != dest.resolve():
        shutil.copy2(src, dest)
    state = State()
    proj = state.get_project(str(root), reg_name)
    proj["name"] = reg_name
    proj["int"] = pi
    if pi >= state.data["next_proj_int"]:
        state.data["next_proj_int"] = pi + 1
    proj["active_session"] = None
    for si in sess_ints:
        info = sessions_info[si]
        sess_id = id_by_int.get(si, f"s_{si}")
        meta = parse_kv(export.get(coord(pi, si, 1, 1), b"").decode(
            "utf-8", "replace"))
        ck = info["checkpoint"]
        if ck:
            status = "stopped"
            stopped = ck.get("stopped")
            try:
                last_seq = int(ck.get("final_seq", info["max_seq"]))
            except ValueError:
                last_seq = info["max_seq"]
            ckpt_coord = coord(pi, si, 8, 1)
        else:
            status = "interrupted"
            stopped = None
            last_seq = info["max_seq"]
            ckpt_coord = None
        proj["sessions"][sess_id] = {
            "id": sess_id, "int": si, "status": status,
            "started": meta.get("started"), "stopped": stopped,
            "workspace": meta.get("workspace", ""),
            "start_snapshot": {}, "last_seq": last_seq,
            "checkpoint_coord": ckpt_coord, "symlinks_skipped": [],
            "teleported": True}
    if sess_ints:
        proj["next_sess_int"] = max(sess_ints) + 1
    state.save()
    write_delta_state(store, sha256_file(dest),
                      {c: sha256_bytes(b) for c, b in export.items()})

    # ---- briefing
    print(f"teleported: {reg_name} (project int {pi}) from {src}")
    if adopted:
        print(f"adopted: local project renamed to the phext's project "
              f"{reg_name!r}")
    if replaced:
        print("note: replaced the existing local phext for this project")
    print(f"phext_sha256: {src_sha}")
    print(f"integrity: {verdict}")
    for wn in warnings:
        print(f"  ⚠ {wn}")
    print(f"stream verification: {checked} streams checked, "
          f"{failed} failed")
    for si in sess_ints:
        info = sessions_info[si]
        sess_id = id_by_int.get(si, f"s_{si}")
        ck = info["checkpoint"]
        if ck:
            print(f"session {sess_id} (int {si}) — stopped "
                  f"{ck.get('stopped', '?')}")
            print(f"  checkpoint: {coord(pi, si, 8, 1)}")
            print(f"  checkpoint_pre_checksum: "
                  f"{ck.get('pre_checkpoint_checksum', '?')}")
            print(f"  final_seq: {ck.get('final_seq', '?')}")
        else:
            print(f"session {sess_id} (int {si}) — INTERRUPTED "
                  f"(no checkpoint)")
        print("  commands:")
        for seq in info["transcripts"]:
            t = export.get(coord(pi, si, 2, seq), b"").decode(
                "utf-8", "replace")
            first = t.splitlines()[0] if t.splitlines() else ""
            kv = parse_kv(t)
            print(f"    seq {seq}: {first} -> exit "
                  f"{kv.get('exit', '?')}")
        man = export.get(coord(pi, si, 6, 1), b"").decode(
            "utf-8", "replace")
        files = [ln.split("\t")[0] for ln in man.splitlines()
                 if "\t" in ln]
        if files:
            print(f"  files: {', '.join(files[:20])}"
                  + (" …" if len(files) > 20 else ""))
    if sess_ints:
        last_si = sess_ints[-1]
        last_info = sessions_info[last_si]
        if last_info["transcripts"]:
            last_seq = last_info["transcripts"][-1]
            t = export.get(coord(pi, last_si, 2, last_seq), b"").decode(
                "utf-8", "replace")
            first = t.splitlines()[0] if t.splitlines() else ""
            print(f"last_command: {first}")
            print(f"last_exit: {parse_kv(t).get('exit', '?')}")
    print(f"next: ocbox context | ocbox start (session "
          f"s_{proj['next_sess_int']})")
    return 0


# ---------------------------------------------------------------- remaining commands

def cmd_status(argv):
    if argv:
        die("usage: ocbox status")
    root, cfg = find_project_root()
    state = State()
    proj = state.data["projects"].get(str(root))
    store = store_dir_for(root, cfg)
    print(f"project: {cfg['project']}")
    print(f"phext: {store / (safe_phext_name(cfg['project']) + '.phext')}")
    daemon = "not running"
    if store.exists():
        try:
            r = subprocess.run([str(sq_binary()), "status"], cwd=store,
                               capture_output=True, timeout=2)
            lines = r.stdout.decode("utf-8", "replace").splitlines()
            if r.returncode == 0 and lines and \
                    lines[0].startswith("Hosting: "):
                daemon = f"running ({lines[0]})"
        except (subprocess.TimeoutExpired, OSError):
            daemon = "not answering (wedged or starting)"
    print(f"sq daemon: {daemon}")
    if not proj or not proj["sessions"]:
        print("sessions: none")
        return 0
    active = proj.get("active_session")
    print(f"active session: {active or 'none'}")
    for sid in sorted(proj["sessions"]):
        s = proj["sessions"][sid]
        print(f"  {sid} (int {s['int']}): {s['status']} — "
              f"started {s.get('started')}, last_seq {s['last_seq']}")
    return 0


def cmd_ls(argv):
    if argv:
        die("usage: ocbox ls")
    state = State()
    if not state.data["projects"]:
        print("no projects")
        return 0
    for root in sorted(state.data["projects"]):
        proj = state.data["projects"][root]
        print(f"{proj['name']} (int {proj['int']}) — {root}")
        for sid in sorted(proj["sessions"]):
            s = proj["sessions"][sid]
            mark = " *" if proj.get("active_session") == sid else ""
            print(f"  {sid}: {s['status']}{mark}")
    return 0


def cmd_destroy(argv):
    force = "--force" in argv
    rest = [a for a in argv if a != "--force"]
    if rest:
        die("usage: ocbox destroy [--force]")
    root, cfg = find_project_root()
    state = State()
    proj, sess = get_session(state, root, cfg, need_active=False)
    provider = LocalProvider()
    w = None
    if sess["status"] == "active":
        if not force:
            die(f"session {sess['id']} is ACTIVE — `ocbox stop` it "
                f"first, or pass --force to discard it (un-captured "
                f"work is lost; a tombstone is written to the phext)")
        w = writer_for(root, cfg)
        w.insert(coord(proj["int"], sess["int"], 1, 1),
                 f"destroyed: {now_iso()} (destroy --force; session "
                 f"was active — no stop capture)\n")
        w.save()
    provider.destroy(sess["workspace"])
    sess["status"] = "destroyed"
    if proj.get("active_session") == sess["id"]:
        proj["active_session"] = None
    state.save()
    if w is not None:
        w.shutdown()
    print(f"session {sess['id']} destroyed")
    return 0


HELP = """ocbox — opencloudbox-compatible sessions with a phext audit trail (SPEC-v0.2)

usage:
  ocbox init                      create .ocbox.json in the current directory
  ocbox start                     start a session (workspace copy of the project)
  ocbox exec [--interactive] [--timeout SECONDS] [--] <command...>
                                  run a command in the session workspace;
                                  stdin is /dev/null unless --interactive;
                                  timeout also via OCBOX_EXEC_TIMEOUT
  ocbox status                    project + session state
  ocbox ls                        all projects and sessions in this shim home
  ocbox context [--lane <class|n>] [--session <int>] [--full]
                                  resume briefing: toc summary (or scoped/
                                  full listing), coordinates changed since
                                  the last context, latest checkpoint
  ocbox stop                      capture diff+manifest+checkpoint, close the
                                  session, shut down the store's SQ daemon
  ocbox destroy [--force]         delete the session workspace (active
                                  sessions refuse unless --force, which
                                  writes a tombstone to the phext first)
  ocbox teleport-in [--expect-sha256 HEX] [--adopt] <phext-file>
                                  import a phext from another machine:
                                  validated before install, integrity
                                  verdict + SHA-256 printed, writer state
                                  rebuilt from the phext alone; sessions
                                  without checkpoints return as interrupted

environment:
  OCBOX_SHIM_HOME   state dir (default ~/.ocbox-shim)
  OCBOX_EXEC_TIMEOUT  default exec timeout in seconds
  OCBOX_REDACT      comma-separated regexes redacted from recorded
                    commands/streams (best-effort; count is recorded)
  SQ_BIN            path to the sq binary (default: PATH, then ~/.cargo/bin/sq)
  OCBOX_SQ_KEY      ignored — daemon transport is local IPC, no key exists
"""


def main(argv):
    if not argv:
        print(HELP)
        return 2
    cmd, rest = argv[0], argv[1:]
    if cmd in ("-h", "--help", "help"):
        print(HELP)
        return 0
    fn = {"init": cmd_init, "start": cmd_start, "exec": cmd_exec,
          "status": cmd_status, "ls": cmd_ls, "context": cmd_context,
          "stop": cmd_stop, "destroy": cmd_destroy,
          "teleport-in": cmd_teleport_in}.get(cmd)
    if fn is None:
        die(f"unknown command {cmd!r} (see: ocbox help)")
    return fn(rest)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
